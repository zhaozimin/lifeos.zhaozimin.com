# Orca 本机采集与推送配置示例（真实值仅保存在本机 .private/，严禁提交 Git）

# Orca 本机数据库路径（macOS 默认路径，可留空使用默认）
ORCA_DB_PATH=

# 传输模式：vps-ssh（推荐，Mac 不存 Supabase 管理员密钥）或 supabase（直连）
ORCA_SYNC_MODE=vps-ssh

# 增量回看天数（默认 14 天，服务端幂等去重）
ORCA_SYNC_DAYS=14

# 本地会话哈希盐值（建议随机 32 字符，保证同一会话跨次同步哈希稳定）
ORCA_HASH_SALT=replace-with-local-random-salt

# --- 模式 A：通过 SSH 推送到 VPS（推荐）---
ORCA_VPS_SSH_TARGET=lifeos@your-vps-host
ORCA_VPS_REMOTE_CMD=/opt/lifeos-orca/ingest.mjs

# --- 模式 B：直连 Supabase（仅 ORCA_SYNC_MODE=supabase 时需要）---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LIFEOS_OWNER_ID=
