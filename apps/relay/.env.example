# [INPUT]: VPS 私有配置；数据库密钥与微信会话分别保存。
# [OUTPUT]: 传话筒启动配置示例，不包含真实凭据。
# [POS]: relay 的配置契约，部署到 /etc/lifeos/relay.env。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OWNER_AUTH_ID=
WECHAT_STATE_DIR=/var/lib/lifeos/wechat
LOG_LEVEL=info
PARSER_ENABLED=true
AGY_BIN=/home/lifeos/.local/bin/agy
AGY_MODEL=gemini-3.8-flash-low
AGY_WORKSPACE=/var/lib/lifeos/parser-workspace
MEMOS_ENABLED=false
# 启用时从独立的 /etc/lifeos/memos.env 装载 MEMOS_API_KEY。
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
MEMOS_AGENT_ID=lifeos-butler
MEMOS_RECALL_TIMEOUT_MS=3000
