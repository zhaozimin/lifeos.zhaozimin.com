{
  "name": "@lifeos/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "ui": "vite --mode ui --host 127.0.0.1 --port 5173 --strictPort",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node build.mjs",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "dev": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "preview": "vite --host 127.0.0.1",
    "prebuild": "npm --prefix ../subscriptions/web ci && npm --prefix ../subscriptions/web run build:standalone && npm --prefix ../subscriptions/web run build",
    "icons": "node brand-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "^2.1.1",
    "echarts": "6.1.0",
    "fflate": "0.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "0.471.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.3.0",
    "zod": "4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "sharp": "0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  }
}
